{
  "name": "optimiser",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "homepage": "https://syedtaimurhassan.github.io/optimiser/",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "engine:build": "node scripts/build-engine.mjs",
    "predeploy": "npm run build && node scripts/prune-wasm.mjs",
    "deploy": "gh-pages -d dist --dotfiles",
    "bench:build": "VITE_BENCH_SEAM=1 vite build --outDir dist-bench && node scripts/prune-wasm.mjs dist-bench/assets",
    "bench:build:nocoi": "rm -rf dist-bench-nocoi && cp -R dist-bench dist-bench-nocoi && node bench/patch-pthread-pool.mjs dist-bench-nocoi/assets",
    "bench:nocoi": "npm run bench:build:nocoi && node bench/run.mjs --dist=dist-bench-nocoi --no-coi --out=ortools-nocoi.json",
    "bench:fixtures": "node bench/fetch-fixtures.mjs",
    "bench:verify-seam": "node bench/verify-seam.mjs",
    "prebench": "npm run bench:build",
    "bench": "node bench/run.mjs",
    "presmoke": "npm run bench:build",
    "smoke": "node bench/m1-smoke.mjs",
    "presmoke:m3": "npm run bench:build",
    "smoke:m3": "node bench/m3-smoke.mjs",
    "presmoke:m4": "npm run bench:build",
    "smoke:m4": "node bench/m4-smoke.mjs",
    "map:perf": "node bench/m4-perf.mjs",
    "presmoke:m5": "npm run bench:build",
    "smoke:m5": "node bench/m5-smoke.mjs",
    "list:perf": "node bench/m5-perf.mjs",
    "presmoke:m7": "npm run bench:build",
    "smoke:m7": "node bench/m7-smoke.mjs",
    "presmoke:m8": "npm run bench:build",
    "smoke:m8": "node bench/m8-smoke.mjs",
    "test": "node --test 'src/**/*.test.ts'",
    "test:watch": "node --test --watch 'src/**/*.test.ts'",
    "bench:tsplib:fetch": "node bench/fetch-tsplib.mjs",
    "prebench:tsplib": "npm run bench:build",
    "bench:tsplib": "node bench/tsplib.mjs",
    "bench:tsptw:fetch": "node bench/fetch-tsptw.mjs",
    "prebench:tsptw": "npm run bench:build",
    "bench:tsptw": "node bench/tsptw.mjs",
    "prebench:solomon": "npm run bench:build",
    "bench:solomon": "node bench/solomon-routes.mjs"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.9",
    "idb": "^8.0.3",
    "maplibre-gl": "5.24.0",
    "papaparse": "^5.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "wouter": "^3.10.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "esbuild": "^0.28.1",
    "gh-pages": "^6.3.0",
    "or-tools-wasm": "^0.9.1",
    "oxlint": "^1.71.0",
    "playwright": "^1.61.1",
    "rollup": "^4.62.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.6.0"
  }
}
