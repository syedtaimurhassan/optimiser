# Geoapify — geocoding (autocomplete, reverse). See src/lib/geocoding/index.ts.
#
# Committed on purpose. This key ships in the client bundle by construction, so
# it is public the moment the app is deployed; hiding it in a gitignored file
# would buy no secrecy and would leave a fresh clone silently unable to search.
#
# It IS origin-restricted, contrary to what this file said until M12: a live
# check gets 401 "Not allowed" for a foreign Origin and 200 for the GitHub
# Pages one. The free tier also has no billing overage, so the worst case was
# always degradation rather than a bill, and the app fails over to the keyless
# Photon provider when the quota is gone.
#
# http://localhost:5173 is NOT on the allowlist, so `npm run dev` searches on
# Photon. Add it in the Geoapify dashboard if you want the real index locally.
#
# The same key reaches /v1/routematrix, verified in M12. Nothing uses it —
# OSRM is free and faster — but it is there if OSRM's demo server ever goes.
VITE_GEOAPIFY_KEY=91f15307a9cb47e0b8a278a863dcf40e
