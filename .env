# Geoapify — geocoding (autocomplete, reverse). See src/lib/geocoding/index.ts.
#
# Committed on purpose. This key ships in the client bundle by construction, so
# it is public the moment the app is deployed; hiding it in a gitignored file
# would buy no secrecy and would leave a fresh clone silently unable to search.
#
# It is NOT referrer-restricted — the Geoapify dashboard offered no way to do
# it. The free tier has no billing overage, so an abused key degrades rather
# than costing money, and the app fails over to the keyless Photon provider
# when the quota is gone. If key restriction ever becomes available, apply it.
VITE_GEOAPIFY_KEY=91f15307a9cb47e0b8a278a863dcf40e
